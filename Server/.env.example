# Local development works without PostgreSQL. Never commit real credentials.
PORT=4000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:3000
STORAGE_MODE=file
# Generate a long random secret before exposing the API publicly.
JWT_SECRET=replace-with-at-least-32-random-characters
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_KEY=
# Set both to bootstrap your own administrator. No default admin is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Stripe-hosted Checkout uses only the server secret key. Never put it in Client.
STRIPE_SECRET_KEY=
# Optional: retained for future embedded Stripe UI; hosted Checkout needs no browser key.
STRIPE_PUBLISHABLE_KEY=
# Obtain this from the Stripe webhook endpoint after configuring the deployed URL.
STRIPE_WEBHOOK_SECRET=
# PostgreSQL: set STORAGE_MODE=postgres, start docker compose up -d, then run
# npx prisma generate && npx prisma migrate deploy && npm run seed
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_tourism_experience
