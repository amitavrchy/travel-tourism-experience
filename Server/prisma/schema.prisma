generator client {
  provider = "prisma-client-js"
}

model AppState {
  key   String @id
  value String
}

enum Role {
  TRAVELER
  ADMIN
}

enum BookingStatus {
  INQUIRY
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

model Payment {
  id                  String @id
  bookingId           String
  booking             Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  userId              String
  amountCents         Int
  currency            String @default("usd")
  status              PaymentStatus @default(PENDING)
  paymentIntentId     String? @unique
  checkoutUrl         String
  receiptUrl          String?
  refundId            String?
  refundedAmountCents Int @default(0)
  livemode            Boolean @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now())
  @@index([bookingId])
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         Role @default(TRAVELER)
  bookings     Booking[]
  plans        TripPlan[]
}

model Destination {
  id            String @id @default(cuid())
  slug          String @unique
  name          String
  country       String
  region        String
  tagline       String
  description   String
  heroImage     String
  lat           Float
  lng           Float
  bestMonths    Int[]
  tags          String[]
  embedText     String
  color         String
  startingPrice Float
  reading       String
  bestSeason    String
  timezone      String
  pois          Poi[]
  experiences   Experience[]
  packages      TripPackage[]
}

model Poi {
  id            String @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name          String
  kind          String
  description   String
  lat           Float
  lng           Float
}

model Experience {
  id            String @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  slug          String @unique
  title         String
  summary       String
  durationHours Float
  priceFrom     Decimal @db.Decimal(10, 2)
  difficulty    String
  imageUrl      String
}

model TripPackage {
  id            String @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  slug          String @unique
  title         String
  days          Int
  priceFrom     Decimal @db.Decimal(10, 2)
  itineraryJson Json
  heroImage     String
  label         String
  bookings      Booking[]
}

model TripPlan {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  inputJson Json
  planJson  Json
  createdAt DateTime @default(now())
}

model Booking {
  id            String @id @default(cuid())
  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId     String?
  package       TripPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  planId        String?
  title         String
  email         String
  startDate     DateTime @db.Date
  guests        Int
  status        BookingStatus @default(INQUIRY)
  notes         String?
  totalEstimate Decimal @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  payments      Payment[]
}

model JournalPost {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  excerpt     String
  category    String
  body        String
  coverImage  String
  readMinutes Int
  publishedAt DateTime
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

